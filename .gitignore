# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# orchestration scratch
.superpowers/

# playwright mcp scratch (snapshots, console logs)
.playwright-mcp/

# playwright (e2e) — reports, traces, screenshots and the downloaded browser binaries' marker
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# maplibre-gl worker + its sibling, copied verbatim from node_modules by
# scripts/copy-maplibre-worker.mjs (see lib/mapStyle.ts's MAPLIBRE_WORKER_URL) — regenerated on
# every install/dev/build, never committed, so it can't drift out of sync with the installed
# maplibre-gl version.
/public/lib/maplibre/
