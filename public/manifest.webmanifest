{
  "name": "savor",
  "short_name": "savor",
  "description": "Track restaurants and food experiences: places you've been, a want-to-try list, and rankings you define.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0f3b2e",
  "theme_color": "#0f3b2e",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/import",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
